window.FarmData = {
  FEEDS, STAGES, RATIONS, DISEASES, SYMPTOMS, STAGE_RULES, PARAMS, ALERTS,
  
  // بحث علف بالاسم
  findFeed(name) { return FEEDS.find(f => f[0].includes(name) || name.includes(f[0])); },
  
  // الحصول على حصة مرحلة
  getRation(stageIndex) { return RATIONS[stageIndex] || []; },
  
  // حساب احتياجات مرحلة
  getStageNeeds(stageIndex) { return STAGES[stageIndex] || null; },
  
  // تشخيص أعراض
  diagnose(selectedSymptomIndices) {
    return DISEASES.map(d => {
      const matched = SYMPTOMS.filter((s,i) => selectedSymptomIndices.includes(i) && s[1].includes(d.id));
      const totalSymptoms = SYMPTOMS.filter(s => s[1].includes(d.id)).length;
      const matchedCount = matched.length;
      return { disease: d, matched: matchedCount, total: totalSymptoms, score: totalSymptoms ? matchedCount/totalSymptoms : 0 };
    }).filter(r => r.matched > 0).sort((a,b) => b.score - a.score || b.matched - a.matched);
  }
};

